{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "workflows/*.js",
    ".ja/workflows/*.js",
    "workflows/_lib/gate.ts",
    ".ja/workflows/_lib/gate.ts",
    "workflows/**/*.test.{js,ts}",
    "workflows/tests/index.js",
    "hooks/**/tests/*.test.ts",
    "hooks/_lib/hook_payload.ts",
    "skills/**/tests/**/*.test.{js,ts}",
    "skills/_lib/harness_hash.ts",
    ".ja/skills/_lib/harness_hash.ts",
    "skills/**/scripts/*.{js,mjs}",
    ".ja/skills/**/scripts/*.{js,mjs}"
  ],
  "project": [
    "workflows/**/*.{js,ts}",
    ".ja/workflows/**/*.{js,ts}",
    "hooks/**/*.ts",
    "skills/**/*.{js,mjs,ts}",
    ".ja/skills/**/*.{js,mjs,ts}"
  ],
  "ignoreBinaries": ["codex"],
  "ignoreDependencies": ["oxfmt", "^@?textlint"],
  "ignoreFiles": ["workflows/tests/fixtures/**", "skills/*/test/cases/**"]
}
