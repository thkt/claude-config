{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "workflows/*.js",
    ".ja/workflows/*.js",
    "workflows/_lib/gate.ts",
    ".ja/workflows/_lib/gate.ts",
    "workflows/**/*.test.{js,ts}",
    "workflows/tests/index.js",
    "skills/**/tests/**/*.test.js",
    "skills/**/scripts/*.{js,mjs}",
    ".ja/skills/**/scripts/*.{js,mjs}"
  ],
  "project": [
    "workflows/**/*.{js,ts}",
    ".ja/workflows/**/*.{js,ts}",
    "skills/**/*.{js,mjs}",
    ".ja/skills/**/*.{js,mjs}"
  ],
  "ignoreBinaries": ["codex"],
  "ignoreDependencies": ["oxfmt", "^@?textlint"],
  "ignoreFiles": ["workflows/tests/fixtures/**"]
}
